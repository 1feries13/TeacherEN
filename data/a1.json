  {
   "id": "plural",
   "title": "Множественное число: cat → cats",
   "lesson": {
    "intro": "Один предмет — a cat. Несколько — cats. Обычно просто добавляем -s, но есть исключения.",
    "rules": [
     {
      "rule": "Обычно добавляем -s: book → books, phone → phones",
      "examples": [
       [
        "I have two phones.",
        "У меня два телефона.",
        "📱📱"
       ],
       [
        "They are my friends.",
        "Это мои друзья.",
        "👫"
       ]
      ]
     },
     {
      "rule": "После s, x, ch, sh добавляем -es: bus → buses, box → boxes",
      "examples": [
       [
        "Two buses are late.",
        "Два автобуса опаздывают.",
        "🚌"
       ],
       [
        "I have three boxes.",
        "У меня три коробки.",
        "📦"
       ]
      ]
     },
     {
      "rule": "Особые слова нужно запомнить: man → men, woman → women, child → children",
      "examples": [
       [
        "Two children play.",
        "Двое детей играют.",
        "🧒"
       ],
       [
        "Women and men work here.",
        "Здесь работают женщины и мужчины.",
        "👩👨"
       ]
      ]
     }
    ]
   },
   "exercises": [
    {
     "type": "choice",
     "q": "one book, two ___",
     "options": [
      "books",
      "bookes",
      "book"
     ],
     "answer": "books",
     "why": "Обычное слово: просто -s."
    },
    {
     "type": "choice",
     "q": "one box, three ___",
     "options": [
      "boxs",
      "boxes",
      "boxies"
     ],
     "answer": "boxes",
     "why": "После x добавляем -es."
    },
    {
     "type": "choice",
     "q": "one child, two ___",
     "options": [
      "childs",
      "childrens",
      "children"
     ],
     "answer": "children",
     "why": "Особая форма, её просто запоминают."
    },
    {
     "type": "fill",
     "q": "one apple, five ___",
     "answer": "apples",
     "why": "Обычное слово: -s."
    },
    {
     "type": "fill",
     "q": "one bus, two ___",
     "answer": "buses",
     "why": "После s добавляем -es."
    },
    {
     "type": "build",
     "q": "У меня два брата.",
     "answer": "I have two brothers.",
     "words": [
      "I",
      "have",
      "two",
      "brothers",
      "brother",
      "am"
     ],
     "why": "После two слово во множественном числе."
    }
   ]
  }
 ]
}
